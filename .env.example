# ===========================================
# データベース接続 (PostgreSQL)
# ===========================================
# ローカル開発例:
#   postgresql://postgres:postgres@localhost:5432/gb_manual?schema=public
# Supabase の場合は「Connection string」(Transaction pooler) を利用してください。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gb_manual?schema=public"

# Prisma migrate 用の直結 URL（Supabase 等でコネクションプーラを使う場合に指定）
# プーラを使わない場合は DATABASE_URL と同じ値で構いません。
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gb_manual?schema=public"

# ===========================================
# NextAuth.js v5
# ===========================================
# 32 文字以上のランダム文字列。生成例: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# 本番(Vercel)では自動で設定されるため通常は不要。ローカルでは未設定で可。
# NEXTAUTH_URL="http://localhost:3000"
